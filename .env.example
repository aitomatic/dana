# =============================================================================
# Dana Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#
# QUICK START: You only need ONE of these API keys to get started:
#   OPENAI_API_KEY=sk-...        (OpenAI)
#   ANTHROPIC_API_KEY=sk-ant-... (Anthropic)
#
# Dana searches for .env files in this order:
#   1. Current working directory (./.env) - project-specific
#   2. Dana user directory (~/.dana/.env) - user global
#   3. User home directory (~/.env) - system global
# =============================================================================


# =============================================================================
# LLM PROVIDERS (Choose at least ONE)
# =============================================================================
# Provider Priority: Dana auto-selects the highest-priority available provider.
# Adjust these values to change provider preference (higher = preferred).
OPENAI_PRIORITY=100
ANTHROPIC_PRIORITY=90
GEMINI_PRIORITY=85
GROQ_PRIORITY=80
LLAMASTACK_PRIORITY=75
OPENROUTER_PRIORITY=70
BEDROCK_PRIORITY=65
DEEPSEEK_PRIORITY=60
COHERE_PRIORITY=55
MOONSHOT_PRIORITY=50
QWEN_PRIORITY=50
WATSONX_PRIORITY=45
AZURE_PRIORITY=40
OLLAMA_PRIORITY=20
HUGGINGFACE_PRIORITY=5

# --- OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini  # Latest & cheap. Alternatives: gpt-4o (smarter), gpt-4.1-mini (newer)

# --- Anthropic ---
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Azure OpenAI ---
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
# AZURE_OPENAI_API_URL=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-11-01-preview
# AZURE_OPENAI_API_TYPE=azure
# AZURE_OPENAI_MODEL=gpt-4

# --- Groq (Fast inference) ---
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_API_URL=https://api.groq.com/openai/v1

# --- DeepSeek ---
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- OpenRouter (Access to multiple providers) ---
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- LlamaStack ---
# LLAMA_STACK_API_KEY=your_llamastack_api_key_here
# LLAMA_STACK_URL=http://localhost:8321
# LLAMASTACK_MODEL=meta-llama/Llama-3.2-3B-Instruct

# --- Ollama (Local) ---
# OLLAMA_API_KEY=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Local LLM (vLLM, LM Studio, etc.) ---
# LOCAL_API_KEY=local
# LOCAL_BASE_URL=http://localhost:8000/v1
# LOCAL_MODEL_NAME=llama3.1:8b
# VLLM_API_MODEL_NAME=your_model_name

# --- Hugging Face ---
# HF_TOKEN=your_huggingface_token_here
# HF_URL=https://router.huggingface.co/v1

# --- Moonshot (Kimi) ---
# MOONSHOT_API_KEY=your_moonshot_api_key_here
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# --- Qwen (Alibaba Cloud) ---
# QWEN_API_KEY=your_qwen_api_key_here
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- Google Gemini ---
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash-preview-04-17

# --- Cohere ---
# COHERE_API_KEY=your_cohere_api_key_here

# --- WatsonX (IBM) ---
# WATSONX_API_KEY=your_watsonx_api_key_here
# WATSONX_SERVICE_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_PROJECT_ID=your_project_id


# =============================================================================
# AWS BEDROCK
# =============================================================================
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_SESSION_TOKEN=your_aws_session_token
# AWS_REGION=us-east-1
# AWS_BEDROCK_VPC_ENDPOINT_URL=https://vpce-xxx.bedrock-runtime.region.vpce.amazonaws.com
# ANTHROPIC_BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0


# =============================================================================
# WEB SEARCH (Google Custom Search)
# =============================================================================
# GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_SEARCH_ENGINE_ID=your_custom_search_engine_id
# Alternative names:
# GOOGLE_SEARCH_API_KEY=your_google_api_key_here
# GOOGLE_SEARCH_CX=your_custom_search_engine_id
# GOOGLE_CSE_ID=your_custom_search_engine_id

# Search configuration
# GOOGLE_SEARCH_MAX_RESULTS=25
# GOOGLE_SEARCH_TIMEOUT=30
# GOOGLE_SEARCH_MAX_CONTENT_LENGTH=50000
# GOOGLE_SEARCH_CONTENT_TIMEOUT=15
# GOOGLE_SEARCH_MAX_CONCURRENT=10
# ENABLE_CONTENT_EXTRACTION=true
# ENABLE_DOMAIN_FOCUS=false
# ENABLE_SITES_FOCUS=false

# --- Llama Search ---
# LLAMA_SEARCH_API_KEY=your_llama_search_api_key


# =============================================================================
# OBSERVABILITY (Langfuse)
# =============================================================================
# LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
# LANGFUSE_SECRET_KEY=your_langfuse_secret_key
# LANGFUSE_HOST=https://cloud.langfuse.com


# =============================================================================
# VISION / AI CAPTURE
# =============================================================================
# USE_VISION=openai
# MAX_CONCURRENT_TASKS=20
# VISION_PARSER_DPI=333

# Vision-specific OpenAI settings (falls back to main OPENAI_* vars)
# OPENAI_VISION_API_KEY=your_openai_api_key_here
# OPENAI_VISION_MODEL=gpt-4.1-mini
# OPENAI_VISION_BASE_URL=https://api.openai.com/v1
# OPENAI_MAX_TOKENS=5000
# OPENAI_TEMPERATURE=0.0


# =============================================================================
# STORAGE (MinIO / S3)
# =============================================================================
# USE_MINIO=false
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# DXA_DATA_BUCKET=test-bucket-local


# =============================================================================
# RAG (Retrieval Augmented Generation)
# =============================================================================
# RAG_CACHE_PATH=~/.dana/.cache/rag


# =============================================================================
# DANA CONFIGURATION
# =============================================================================
# Storage mode (default: file)
# DANA_STORAGE_MODE=file

# Custom module search paths (colon-separated on Unix, semicolon on Windows)
# DANAPATH=/path/to/modules:/another/path

# Override default config file location
# DANA_CONFIG=/path/to/your/dana_config.json

# Database URL (for studio/API)
# DANA_DATABASE_URL=sqlite:///./dana.db

# Aitomatic API
# AITOMATIC_API_URL=http://localhost:8000
# AITOMATIC_API_KEY=your_aitomatic_api_key


# =============================================================================
# DANA DEBUG / DEVELOPMENT
# =============================================================================
# Enable test mode
# DANA_TEST_MODE=false

# Enable console logging
# DANA_CONSOLE_LOGGING=false

# Mock LLM calls (for testing)
# DANA_MOCK_LLM=false

# Skip LLM tests in NA syntax tests
# DANA_SKIP_NA_LLM_TESTS=false

# TUI settings
# DANA_FULLSCREEN=false
# DANA_TUI_MINIMAL=false

# Type checking and coercion
# DANA_TYPE_CHECK=1
# DANA_AUTO_COERCION=1
# DANA_LLM_AUTO_COERCION=1


# =============================================================================
# DANA MEMORY (Claude Code hooks)
# =============================================================================
# Install hooks with: dana-memory hooks install
# See: dana_agent/dana/lib/memory/hooks/README.md

# Enable/disable memory injection in Claude Code
DANA_MEMORY_ENABLED=1

# Minimum relevance score (0.0-1.0) for memory injection
DANA_MEMORY_MIN_SCORE=0.1

# Maximum number of memories to inject per tool call
DANA_MEMORY_LIMIT=3

# Filter memories by identity (leave empty for all domains)
# DANA_MEMORY_IDENTITY=

# Tools to skip memory lookup for (comma-separated)
DANA_MEMORY_SKIP_TOOLS=Glob,Grep,Bash,TaskList,TaskGet

# Project path for uv run (required if dana-memory not in PATH)
DANA_PROJECT_PATH=~/src/aitomatic/dana-internal
